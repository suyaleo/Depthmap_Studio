# Host port published by Docker Compose. Compose binds it to 127.0.0.1 only.
DEPTHMAP_STUDIO_PORT=8790

# Persistent host directory mounted at /data by Docker Compose.
# Ubuntu deployments use /srv/leostudio/data/depthmap-studio.
DEPTHMAP_STUDIO_DATA_DIR=/srv/leostudio/data/depthmap-studio

# Local web server bind address. Use 127.0.0.1 for machine-local access.
DEPTHMAP_STUDIO_HOST=0.0.0.0

# OCI metadata used for local image builds.
APP_VERSION=1.0.0
VCS_REF=development
